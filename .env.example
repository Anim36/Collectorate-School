# Environment variables for the Narail Collectorate School web app.
#
# The app runs entirely on mock data today, so nothing is required to start it.
# Each variable below is listed here so the name is settled before the backend
# lands. Copy this file to `.env.local` and fill the values in.
#
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# NEXT_PUBLIC_FIGMA_FILE_KEY=
# FIGMA_ACCESS_TOKEN=
# DATABASE_URL=
