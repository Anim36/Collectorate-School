# Environment variables for the Narail Collectorate School web app.
#
# Copy this file to `.env` and fill in the values. `.env` is git-ignored;
# this file is committed, so it must never hold a real value — only the
# variable names and placeholders below.

# The database the Prisma client in `src/server/db.ts` connects to.
# The schema lives in `prisma/schema.prisma`; run `npm run db:migrate` to
# apply it to the database.
# The shape is: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=""

# A second database Prisma replays the migrations on to work out what the
# next migration should contain. It is dropped and rebuilt every time.
SHADOW_DATABASE_URL=""

# The login of the admin account the seed creates.
SEED_ADMIN_LOGIN=""

# The password of the admin account the seed creates.
SEED_ADMIN_PASSWORD=""

# The password every seeded demo account gets.
SEED_DEMO_PASSWORD=""

# The key the session cookies are signed with. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# The base URL of the API, once one is running.
NEXT_PUBLIC_API_BASE_URL=""

# The Figma file key and access token, used by the design scripts.
NEXT_PUBLIC_FIGMA_FILE_KEY=""
FIGMA_ACCESS_TOKEN=""
