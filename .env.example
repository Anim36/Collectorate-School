# Environment variables for the Narail Collectorate School web app.
#
# The app runs entirely on mock data today, so nothing is required to start it.
# Each variable below is listed here so the name is settled before the backend
# lands. Copy this file to `.env` and fill the values in.
#
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
# NEXT_PUBLIC_FIGMA_FILE_KEY=
# FIGMA_ACCESS_TOKEN=

# The PostgreSQL database the Prisma client in `src/server/db.ts` connects to.
# The schema lives in `prisma/schema.prisma`; run `npm run db:migrate` to
# apply it to the database.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/narail_school"

# A second database Prisma replays the migrations on to work out what the
# next migration should contain. It is dropped and rebuilt every time.
SHADOW_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/narail_school_shadow"

# The account the first migration seeds, and the password every seeded
# demo account gets.
SEED_ADMIN_LOGIN="Admin"
SEED_ADMIN_PASSWORD=""
SEED_DEMO_PASSWORD=""
AUTH_SECRET=""